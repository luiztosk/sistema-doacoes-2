		"test:inventory": "tsx tests/inventory.ts",
		"typecheck": "tsc -p tsconfig.app.json --noEmit",
		"gen-auth": "auth generate --config=./src/auth.config.ts --output=./src/schemas/db/auth.ts --yes",
		"gen-drizzle": "drizzle-kit generate",
		"db-seed": "tsx scripts/seed.ts",
		"db-wipe": "tsx scripts/wipe.ts",
		"db-init": "bun scripts/db-init.js",
		"db-reset": "bun scripts/db-init.js --local --force",
		"db-reset-remote": "bun scripts/db-init.js --remote --force",
		"preview": "bun run build && vite preview",
		"update-openapi": "tsx scripts/openapi.ts"
	},
	"type": "module",
	"packageManager": "bun@1.4.2"
