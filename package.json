	"scripts": {
		"build": "bun run lint && tsc -b && bun run test && vite build",
		"cf-typegen": "wrangler types",
		"check": "bun run build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite dev",
		"lint": "eslint .",
		"test": "tsx tests/api.ts && tsx tests/format.ts",
